# Copy to .env.local for local runs. On Vercel, add the same names under
# Project Settings > Environment Variables. Never commit real values.

# Account used to send contact and live demo emails. Form submissions are delivered to schoolynx@gmail.com.
SMTP_USER=
# Gmail app password (Google Account > Security > App passwords), not the account password.
SMTP_PASS=
# Optional: nodemailer service name (defaults to gmail).
SMTP_SERVICE=
